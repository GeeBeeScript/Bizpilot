// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ToneOptions {
  blue
  gold
  emerald
  sapphire
  amber
  crimson
}

enum ClientStatus {
  active
  onboarding
  paused
  inactive
}

enum Health {
  on_track
  at_risk
  off_track
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
}

enum Priority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  backlog
  todo
  in_progress
  review
  blocked
  done
}

enum DocumentStatus {
  uploading
  processing
  indexing
  ready
  failed
}

enum DocumentItemKind {
  pdf
  docx
  xlsx
  image
  other
}

enum ActivityKind {
  upload
  approval
  comment
  complete
  assign
  create
  update
  ai
  alert
}

enum MileStoneStatus {
  done
  upcoming
  late
  awaiting_approval
}

enum AttentionType {
  overdue_project
  blocked_task
  approval
  follow_up
  automation
  document
}

enum AttentionUrgency {
  critical
  high
  medium
}

enum DeadlineKind {
  milestone
  task
}

enum DeadlineStatus {
  on_track
  at_risk
  late
}

enum NotificationCategory {
  mentions
  tasks
  projects
  clients
  ai
  billing
}

enum kpiCategoryId {
  clients
  projects
  overdue
  revenue
  ai
}

enum kpiTrend {
  up
  down
  flat
}

enum kpiSentiment {
  positive
  negative
  neutral
}

enum SingletonId {
  SINGLETON
}

// AI enums

enum AIScopeKind {
  workspace
  client
  project
  document
}

enum AICitationKind {
  document
  client
  project
  task
  activity
}

enum AIProposedActionKind {
  create_task
  send_email
  update_status
  update_client
}

enum AIProposedActionState {
  pending
  approved
  dismissed
}

enum AIMessageRole {
  user
  assistant
}

enum AIMessageStatus {
  thinking
  streaming
  done
  error
  stoppped
}

// Automation enums

enum AutomationNodeKind {
  trigger
  condition
  action
  ai
}

enum AutomationRunStatus {
  success
  failed
  running
  retrying
}

enum AutomationRunStepsState {
  done
  active
  pending
  failed
}

enum AutomationTriggerType {
  client
  project
  task
  document
  billing
}

// Team enums

enum Roles {
  owner
  admin
  manager
  employee
}

enum TeamMemberStatus {
  active
  invited
  deactivated
}

// Billing & usage enums

enum InvoiceStatus {
  paid
  open
  failed
}

enum PlanCategoryId {
  starter
  growth
  scale
}

// Settings enums

enum IntegrationStatus {
  connected
  error
  available
}

enum TeammateStatus {
  Admin
  Manager
  Employee
}

